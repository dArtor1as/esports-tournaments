# База даних
POSTGRES_USER=artur_admin
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=esports_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# URL для підключення Prisma (генерується з параметрів вище)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Redis
REDIS_PORT=6379
REDIS_HOST=localhost

# JWT (для локальної розробки можна використати будь-який рядок)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Mailtrap (для тестування відправки листів)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mailtrap_user
MAIL_PASS=your_mailtrap_password
MAIL_FROM="Esports Platform <noreply@esports.com>"

# Frontend
FRONTEND_URL=http://localhost:3001

# Node Environment
NODE_ENV=development